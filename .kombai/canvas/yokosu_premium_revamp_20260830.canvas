        Email address\n                    </div>\n                    <div class=\"auth-field-value\" data-kid=\"1-6-3-3-2-2\">\n                        alex@example.com\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-4\">\n                <i class=\"ti ti-lock\" data-kid=\"1-6-3-4-1\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-4-2\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-4-2-1\">\n                        Password\n                    </div>\n                    <div class=\"auth-field-value\" data-kid=\"1-6-3-4-2-2\">\n                        ••••••••••\n                    </div>\n                </div>\n                <i class=\"ti ti-eye\" data-kid=\"1-6-3-4-3\" style=\"color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"auth-submit\" data-kid=\"1-6-3-5\">\n                Sign in\n            </div>\n            <div class=\"auth-foot\" data-kid=\"1-6-3-6\">\n                <span data-kid=\"1-6-3-6-1\">\n                    New here?\n                </span>\n                <strong data-kid=\"1-6-3-6-2\">\n                    Create account\n                </strong>\n            </div>\n            <div class=\"auth-state\" data-kid=\"1-6-3-7\">\n                <div class=\"auth-state-row\" data-kid=\"1-6-3-7-1\">\n                    <i class=\"ti ti-loader-2\" data-dynamic=\"true\" data-kid=\"1-6-3-7-1-1\" data-name=\"loading spinner icon\" data-reason=\"rotated by css animation when visible\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-6-3-7-1-2\" data-name=\"signing in status text\" data-reason=\"text reflects async auth state\">\n                        Signing in · quiet inline progress\n                    </span>\n                </div>\n                <div class=\"auth-state-row error\" data-kid=\"1-6-3-7-2\">\n                    <i class=\"ti ti-alert-circle\" data-kid=\"1-6-3-7-2-1\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-6-3-7-2-2\" data-name=\"error status message\" data-reason=\"text reflects async auth state\">\n                        Couldn’t sign in · Try again\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"1-6-3-8\" style=\"height:52px\">\n            </div>\n            <div class=\"auth-head\" data-kid=\"1-6-3-9\" style=\"padding-bottom:18px\">\n                <h1 data-kid=\"1-6-3-9-1\" style=\"font-size:25px;line-height:31px\">\n                    Set up your profile\n                </h1>\n                <p data-kid=\"1-6-3-9-2\">\n                    This is how people will find you.\n                </p>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-10\">\n                <i class=\"ti ti-badge\" data-kid=\"1-6-3-10-1\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-10-2\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-10-2-1\">\n                        Your name\n                    </div>\n                    <div class=\"auth-field-value muted\" data-kid=\"1-6-3-10-2-2\">\n                        Alex Morgan\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-11\">\n                <i class=\"ti ti-at\" data-kid=\"1-6-3-11-1\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-11-2\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-11-2-1\">\n                        Username\n                    </div>\n                    <div class=\"auth-field-value muted\" data-kid=\"1-6-3-11-2-2\">\n                        alexm\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-submit\" data-kid=\"1-6-3-12\">\n                Create profile\n            </div>\n        </div>\n    </section>\n    <section class=\"snapshot snapshot-states\" data-kid=\"1-7\">\n        <div class=\"board-caption\" data-kid=\"1-7-1\">\n            <span data-kid=\"1-7-1-1\">\n                07\n            </span>\n            / states · compact system strip\n        </div>\n        <div class=\"states-intro\" data-kid=\"1-7-2\">\n            <h2 data-kid=\"1-7-2-1\">\n                Quiet, truthful states\n            </h2>\n            <p data-kid=\"1-7-2-2\">\n                Every state uses the same hierarchy: one small cue, one clear sentence, one next step.\n            </p>\n        </div>\n        <div class=\"state-grid\" data-kid=\"1-7-3\">\n            <div class=\"state-cell\" data-kid=\"1-7-3-1\">\n                <i class=\"ti ti-message-off\" data-kid=\"1-7-3-1-1\">\n                </i>\n                <h3 data-kid=\"1-7-3-1-2\">\n                    No conversations yet\n                </h3>\n                <p data-kid=\"1-7-3-1-3\">\n                    Search by username to start one.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-1-4\">\n                    Search\n                </span>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-2\">\n                <i class=\"ti ti-message-circle\" data-kid=\"1-7-3-2-1\">\n                </i>\n                <h3 data-kid=\"1-7-3-2-2\">\n                    No messages yet\n                </h3>\n                <p data-kid=\"1-7-3-2-3\">\n                    Write the first message.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-2-4\">\n                    Write message\n                </span>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-3\">\n                <i class=\"ti ti-loader-2\" data-kid=\"1-7-3-3-1\">\n                </i>\n                <div class=\"skeleton-line\" data-kid=\"1-7-3-3-2\">\n                </div>\n                <div class=\"skeleton-line short\" data-kid=\"1-7-3-3-3\">\n                </div>\n                <p data-kid=\"1-7-3-3-4\">\n                    Loading messages\n                </p>\n            </div>\n            <div class=\"state-cell error\" data-kid=\"1-7-3-4\">\n                <i class=\"ti ti-alert-circle\" data-kid=\"1-7-3-4-1\">\n                </i>\n                <h3 data-kid=\"1-7-3-4-2\">\n                    Couldn’t load messages\n                </h3>\n                <p data-kid=\"1-7-3-4-3\">\n                    Your saved messages are still here.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-4-4\">\n                    Try again\n                </span>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-5\">\n                <i class=\"ti ti-photo-off\" data-kid=\"1-7-3-5-1\">\n                </i>\n                <h3 data-kid=\"1-7-3-5-2\">\n                    No shared media\n                </h3>\n                <p data-kid=\"1-7-3-5-3\">\n                    Photos will appear here.\n                </p>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-6\">\n                <i class=\"ti ti-users-minus\" data-kid=\"1-7-3-6-1\">\n                </i>\n                <h3 data-kid=\"1-7-3-6-2\">\n                    No members match\n                </h3>\n                <p data-kid=\"1-7-3-6-3\">\n                    Try a different name.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-6-4\">\n                    Clear search\n                </span>\n            </div>\n        </div>\n        <div class=\"note\" data-kid=\"1-7-4\">\n            One palette. One rail. No false presence, delivery, or security claims. All primary flows remain recognizably YOKOSU and ready for Compose translation.\n        </div>\n    </section>\n</div>\n",
      "comments": [],
      "created": "2026-08-30T14:26:11.829138+00:00",
      "modified": "2026-08-30T14:27:44.324655+00:00",
      "id": "var_9a52280e818e"
    },
    "var_7a8664b0550d": {
      "type": "variant",
      "label": "YOKOSU — Editorial Quiet Inbox",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1900,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@350;400;500;600;650;700&display=swap');\n  :root {\n    --pearl: #F7F7F5;\n    --white: #FFFFFF;\n    --stone: #EEEDEA;\n    --graphite: #29282D;\n    --muted: #77757D;\n    --border: #E3E2E5;\n    --divider: #EFEFEB;\n    --lavender: #8D88C7;\n    --lavender-tint: #EAE8F5;\n    --lavender-deep: #7570AE;\n    --sage: #88A99A;\n    --sage-tint: #E5EEEA;\n    --danger: #D46868;\n    --danger-tint: #FBEAEA;\n  }\n  .editorial-board {\n    font-family: 'Manrope', sans-serif;\n    color: var(--graphite);\n    background: var(--pearl);\n    letter-spacing: -0.01em;\n  }\n  .editorial-board button,\n  .editorial-board input { font: inherit; }\n  .route-kicker {\n    color: var(--muted);\n    font-size: 9px;\n    line-height: 12px;\n    letter-spacing: .16em;\n    font-weight: 650;\n    text-transform: uppercase;\n  }\n  .hairline { height: 1px; background: var(--border); }\n  .soft-rule { height: 1px; background: var(--divider); }\n  .touch-target {\n    width: 48px;\n    height: 48px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--graphite);\n    border-radius: 14px;\n  }\n  .touch-target.quiet { color: var(--muted); }\n  .touch-target.pressed { background: var(--stone); }\n  .icon {\n    width: 20px;\n    height: 20px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n    line-height: 1;\n  }\n  .avatar {\n    width: 48px;\n    height: 48px;\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n    background: var(--lavender-tint);\n    border: 1px solid rgba(227,226,229,.9);\n    color: var(--graphite);\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 650;\n  }\n  .avatar.small { width: 36px; height: 36px; font-size: 11px; }\n  .avatar.large { width: 104px; height: 104px; font-size: 26px; }\n  .avatar.stone { background: var(--stone); }\n  .presence {\n    width: 9px;\n    height: 9px;\n    border-radius: 999px;\n    background: var(--sage);\n    border: 2px solid var(--pearl);\n    position: absolute;\n    right: 0;\n    bottom: 1px;\n  }\n  .mosaic {\n    overflow: hidden;\n    position: relative;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    grid-template-rows: 1fr 1fr;\n    gap: 1px;\n    padding: 1px;\n    background: var(--white);\n  }\n  .mosaic span:nth-child(1) { background: var(--stone); color: var(--graphite); }\n  .mosaic span:nth-child(2) { background: var(--lavender-tint); color: var(--lavender-deep); }\n  .mosaic span:nth-child(3) { background: var(--lavender-tint); color: var(--graphite); }\n  .mosaic span:nth-child(4) { background: var(--stone); color: var(--muted); }\n  .mosaic span {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 9px;\n    font-weight: 700;\n  }\n  .mosaic.avatar { border: 1px solid var(--border); padding: 0; }\n  .mosaic.avatar.large { border-radius: 28px; }\n  .mosaic.avatar.small { border-radius: 12px; }\n  .selected-row {\n    position: relative;\n    background: var(--lavender-tint);\n    border-radius: 10px;\n  }\n  .selected-row .reply-mark {\n    position: absolute;\n    left: 8px;\n    bottom: 11px;\n    width: 14px;\n    height: 2px;\n    background: var(--lavender);\n    border-radius: 99px;\n  }\n  .search-well {\n    height: 48px;\n    border-radius: 10px;\n    background: var(--stone);\n    border: 1px solid rgba(227,226,229,.72);\n    display: flex;\n    align-items: center;\n  }\n  .nav-shelf {\n    border-top: 1px solid var(--border);\n    box-shadow: 0 -5px 20px rgba(41,40,45,.045);\n  }\n  .nav-active {\n    background: var(--lavender-tint);\n    color: var(--lavender-deep);\n    border-radius: 999px;\n  }\n  .message-bubble {\n    max-width: 78%;\n    border-radius: 14px;\n    padding: 10px 12px 8px;\n    font-size: 14px;\n    line-height: 20px;\n  }\n  .message-bubble.incoming {\n    background: var(--stone);\n    border-bottom-left-radius: 5px;\n  }\n  .message-bubble.outgoing {\n    background: var(--lavender-tint);\n    border-bottom-right-radius: 5px;\n  }\n  .bubble-meta {\n    margin-top: 5px;\n    color: var(--muted);\n    font-size: 10px;\n    line-height: 13px;\n    letter-spacing: .01em;\n  }\n  .reply-snippet {\n    border-left: 2px solid var(--lavender);\n    padding-left: 8px;\n    margin-bottom: 8px;\n    color: var(--muted);\n    font-size: 11px;\n    line-height: 15px;\n  }\n  .file-row {\n    border: 1px solid var(--border);\n    background: var(--white);\n    border-radius: 10px;\n  }\n  .composer {\n    border: 1px solid var(--border);\n    background: var(--white);\n    border-radius: 14px;\n    box-shadow: 0 3px 12px rgba(41,40,45,.06);\n  }\n  .composer-field {\n    min-height: 44px;\n    display: flex;\n    align-items: center;\n    color: var(--muted);\n    font-size: 14px;\n  }\n  .send-disc {\n    width: 40px;\n    height: 40px;\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: var(--lavender);\n    color: var(--white);\n  }\n  .grouped-list {\n    background: var(--white);\n    border-top: 1px solid var(--border);\n    border-bottom: 1px solid var(--border);\n  }\n  .section-label {\n    font-size: 11px;\n    line-height: 15px;\n    font-weight: 650;\n    color: var(--muted);\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n  .auth-field {\n    min-height: 56px;\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    background: var(--white);\n  }\n  .state-mini {\n    min-height: 112px;\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    background: var(--white);\n  }\n  .skeleton-line { background: var(--stone); border-radius: 99px; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"editorial-board min-h-full w-full overflow-hidden bg-[var(--pearl)]\" data-kid=\"2\" data-name=\"editorial board container\">\n    <!-- Board framing -->\n    <div class=\"px-5 pt-6 pb-4\" data-kid=\"2-1\" data-name=\"board framing header\">\n        <div class=\"flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"header information container\">\n            <div class=\"route-kicker\" data-kid=\"2-1-1-1\" data-name=\"route kicker label\">\n                YOKOSU / editorial quiet inbox\n            </div>\n            <div class=\"text-[9px] font-medium tracking-[0.12em] text-[var(--muted)]\" data-kid=\"2-1-1-2\" data-name=\"screen width indicator\">\n                375 PX\n            </div>\n        </div>\n        <div class=\"mt-3 hairline\" data-kid=\"2-1-2\" data-name=\"hairline divider\">\n        </div>\n        <p class=\"mt-3 max-w-[292px] text-[11px] leading-[16px] text-[var(--muted)]\" data-kid=\"2-1-3\" data-name=\"system description text\">\n            A calm, message-first system for the existing Compose routes — structured as a single review board.\n        </p>\n    </div>\n    <!-- 01 Home / Messages — dominant opening route -->\n    <section class=\"border-t border-[var(--border)] bg-[var(--pearl)] px-5 pb-0 pt-5\" data-kid=\"2-2\" data-name=\"home messages section\">\n        <div class=\"flex items-center justify-between\" data-kid=\"2-2-1\" data-name=\"section header container\">\n            <div class=\"route-kicker\" data-kid=\"2-2-1-1\" data-name=\"route kicker label\">\n                01 / route home\n            </div>\n            <div class=\"text-[10px] font-medium text-[var(--muted)]\" data-kid=\"2-2-1-2\" data-name=\"section breadcrumb label\">\n                Home\n            </div>\n        </div>\n        <div class=\"mt-7 flex items-start justify-between\" data-kid=\"2-2-2\" data-name=\"messages header container\">\n            <div data-kid=\"2-2-2-1\" data-name=\"title and description container\">\n                <div class=\"text-[36px] font-[350] leading-[42px] tracking-[-0.055em] text-[var(--graphite)]\" data-kid=\"2-2-2-1-1\" data-name=\"messages section headline\">\n                    Messages\n                </div>\n                <div class=\"mt-2 text-[12px] leading-[16px] text-[var(--muted)]\" data-kid=\"2-2-2-1-2\" data-name=\"messages section subheadline\">\n                    Your conversations, kept close.\n                </div>\n            </div>\n            <div class=\"flex items-center gap-1 pt-1\" data-kid=\"2-2-2-2\" data-name=\"header action buttons container\">\n                <div aria-label=\"New group\" class=\"touch-target quiet\" data-kid=\"2-2-2-2-1\" data-name=\"new group button\">\n                    <i class=\"ti ti-square-rounded-plus icon\" data-kid=\"2-2-2-2-1-1\" data-name=\"plus square icon\" style=\"width:20px;height:20px;color:var(--muted)\">\n                    </i>\n                </div>\n                <div class=\"relative\" data-kid=\"2-2-2-2-2\" data-name=\"user profile indicator\">\n                    <div class=\"avatar small bg-[var(--lavender-tint)]\" data-kid=\"2-2-2-2-2-1\" data-name=\"user avatar\">\n                        AM\n                    </div>\n                    <span class=\"presence\" data-kid=\"2-2-2-2-2-2\" data-name=\"presence indicator dot\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"search-well mt-7 px-3.5\" data-kid=\"2-2-3\" data-name=\"search input field\">\n            <i class=\"ti ti-search icon mr-2.5\" data-kid=\"2-2-3-1\" data-name=\"search magnifying glass icon\" style=\"width:19px;height:19px;color:var(--muted)\">\n            </i>\n            <span class=\"text-[13px] leading-[18px] text-[var(--muted)]\" data-kid=\"2-2-3-2\" data-name=\"search placeholder text\">\n                Search by username\n            </span>\n            <span class=\"ml-auto text-[10px] font-medium text-[var(--muted)]\" data-kid=\"2-2-3-3\" data-name=\"search shortcut label\">\n                ⌘ K\n            </span>\n        </div>\n        <div class=\"mt-7 flex items-center justify-between\" data-kid=\"2-2-4\" data-name=\"recent messages header container\">\n            <div class=\"section-label\" data-kid=\"2-2-4-1\" data-name=\"section label\">\n                Recent\n            </div>\n            <div class=\"text-[11px] text-[var(--muted)]\" data-kid=\"2-2-4-2\" data-name=\"conversation count label\">\n                5 conversations\n            </div>\n        </div>\n        <div class=\"mt-2 -mx-2\" data-kid=\"2-2-5\" data-name=\"conversation list container\">\n            <!-- Selected conversation -->\n            <div class=\"selected-row px-2 py-3\" data-kid=\"2-2-5-1\" data-name=\"selected conversation item\">\n                <span class=\"reply-mark\" data-kid=\"2-2-5-1-1\" data-name=\"active conversation indicator\">\n                </span>\n                <div class=\"flex items-center gap-3.5\" data-kid=\"2-2-5-1-2\" data-name=\"conversation item content\">\n                    <div class=\"relative\" data-kid=\"2-2-5-1-2-1\" data-name=\"conversation avatar container\">\n                        <div class=\"avatar bg-[var(--lavender-tint)]\" data-kid=\"2-2-5-1-2-1-1\" data-name=\"conversation avatar\">\n                            MC\n                        </div>\n                        <span class=\"presence\" data-kid=\"2-2-5-1-2-1-2\" data-name=\"presence indicator\">\n                        </span>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-1-2-2\" data-name=\"conversation details container\">\n                        <div class=\"flex items-baseline justify-between gap-2\" data-kid=\"2-2-5-1-2-2-1\" data-name=\"conversation header container\">\n                            <div class=\"truncate text-[15px] font-[650