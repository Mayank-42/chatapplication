    "var_0afee022de0f": {
      "type": "variant",
      "label": "YOKOSU — Tactile System Surface",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2375,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@350;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root {\n  --pearl: #F7F7F5;\n  --white: #FFFFFF;\n  --stone: #EEEDEA;\n  --graphite: #29282D;\n  --muted: #77757D;\n  --border: #E3E2E5;\n  --lavender: #8D88C7;\n  --lavender-tint: #EAE8F5;\n  --sage: #88A99A;\n  --danger: #B96268;\n  --danger-tint: #F6E8E8;\n}\n\nbody {\n  margin: 0;\n  background: var(--pearl);\n  color: var(--graphite);\n  font-family: 'Manrope', sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton {\n  border: 0;\n  padding: 0;\n  color: inherit;\n  background: transparent;\n  font: inherit;\n}\n\n.board {\n  width: 100%;\n  max-width: 375px;\n  margin: 0 auto;\n  padding: 16px 12px 28px;\n  background: var(--pearl);\n}\n\n.board-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 4px 14px;\n  color: var(--muted);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n}\n\n.board-meta strong {\n  color: var(--graphite);\n  font-weight: 700;\n}\n\n.screen {\n  position: relative;\n  overflow: hidden;\n  margin: 0 0 14px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--pearl);\n}\n\n.screen-label {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 28px;\n  padding: 0 16px;\n  border-bottom: 1px solid var(--border);\n  color: var(--muted);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .13em;\n  text-transform: uppercase;\n}\n\n.screen-label span:last-child {\n  color: var(--lavender);\n  font-weight: 700;\n}\n\n.safe-top {\n  height: 10px;\n}\n\n.eyebrow {\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n}\n\n.home-hero {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  padding: 18px 16px 10px;\n}\n\n.home-hero h1 {\n  margin: 3px 0 0;\n  font-size: 36px;\n  line-height: 1.08;\n  font-weight: 350;\n  letter-spacing: -.055em;\n}\n\n.home-side {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  padding-top: 2px;\n}\n\n.icon-target,\n.bare-action,\n.header-icon,\n.back-hit,\n.composer-target {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 48px;\n  height: 48px;\n  color: var(--muted);\n  font-size: 20px;\n}\n\n.bare-action {\n  color: var(--graphite);\n}\n\n.bare-action i,\n.header-icon i,\n.icon-target i {\n  font-size: 20px;\n}\n\n.avatar {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 auto;\n  width: 42px;\n  height: 42px;\n  overflow: visible;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: var(--lavender-tint);\n  color: var(--graphite);\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: -.02em;\n}\n\n.avatar.small {\n  width: 34px;\n  height: 34px;\n  font-size: 11px;\n}\n\n.avatar.tiny {\n  width: 28px;\n  height: 28px;\n  font-size: 9px;\n}\n\n.avatar.stone {\n  background: var(--stone);\n}\n\n.avatar.sage {\n  background: #E5EEEA;\n}\n\n.presence {\n  position: absolute;\n  right: -1px;\n  bottom: -1px;\n  width: 9px;\n  height: 9px;\n  border: 2px solid var(--white);\n  border-radius: 50%;\n  background: var(--sage);\n}\n\n.search-well {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  height: 48px;\n  margin: 0 8px 14px;\n  padding: 0 14px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--stone);\n  color: var(--muted);\n}\n\n.search-well i {\n  font-size: 19px;\n}\n\n.search-well span {\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.list-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 20px 6px;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .11em;\n  text-transform: uppercase;\n}\n\n.list-heading .count {\n  color: var(--graphite);\n  font-variant-numeric: tabular-nums;\n  font-weight: 600;\n  letter-spacing: 0;\n}\n\n.conversation-row {\n  position: relative;\n  display: flex;\n  align-items: center;\n  min-height: 76px;\n  margin: 0 8px;\n  padding: 10px 12px;\n  border-radius: 8px;\n}\n\n.conversation-row + .conversation-row:not(.selected)::before {\n  position: absolute;\n  top: 0;\n  right: 0;\n  left: 66px;\n  height: 1px;\n  background: var(--border);\n  content: '';\n}\n\n.conversation-row.selected {\n  background: var(--lavender-tint);\n}\n\n.selected-mark {\n  position: absolute;\n  left: 2px;\n  top: 50%;\n  width: 3px;\n  height: 15px;\n  border-radius: 3px;\n  background: var(--lavender);\n  transform: translateY(-50%);\n}\n\n.conversation-copy {\n  min-width: 0;\n  flex: 1;\n  margin-left: 13px;\n}\n\n.conversation-line,\n.preview-line {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.conversation-name {\n  overflow: hidden;\n  color: var(--graphite);\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.time {\n  flex: 0 0 auto;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n\n.preview {\n  overflow: hidden;\n  margin-top: 5px;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.3;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.unread {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 19px;\n  height: 19px;\n  padding: 0 5px;\n  border-radius: 10px;\n  background: var(--stone);\n  color: var(--graphite);\n  font-size: 10px;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n\n.mosaic {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: 1fr 1fr;\n  gap: 1px;\n  width: 42px;\n  height: 42px;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: var(--white);\n}\n\n.mosaic.large {\n  width: 88px;\n  height: 88px;\n  border-width: 2px;\n}\n\n.mosaic span {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--stone);\n  color: var(--graphite);\n  font-size: 9px;\n  font-weight: 700;\n}\n\n.mosaic span:nth-child(2),\n.mosaic span:nth-child(3) {\n  background: var(--lavender-tint);\n}\n\n.mosaic.large span {\n  font-size: 15px;\n}\n\n.bottom-shelf {\n  display: flex;\n  align-items: stretch;\n  justify-content: space-around;\n  min-height: 70px;\n  margin-top: 10px;\n  border-top: 1px solid var(--border);\n  background: var(--white);\n}\n\n.bottom-item {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex: 1;\n  flex-direction: column;\n  gap: 3px;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.bottom-item i {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 24px;\n  border-radius: 8px;\n  font-size: 18px;\n}\n\n.bottom-item.active {\n  color: var(--graphite);\n}\n\n.bottom-item.active i {\n  background: var(--lavender-tint);\n  color: var(--lavender);\n}\n\n.chat-shell {\n  position: relative;\n  overflow: hidden;\n  background: var(--pearl);\n}\n\n.chat-header {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  align-items: center;\n  min-height: 68px;\n  padding: 4px 8px 6px 10px;\n  border-bottom: 1px solid var(--border);\n  background: var(--pearl);\n}\n\n.back-hit {\n  position: relative;\n  flex: 0 0 48px;\n  color: var(--graphite);\n}\n\n.back-disc {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  background: var(--stone);\n  color: var(--graphite);\n}\n\n.back-disc i {\n  font-size: 18px;\n  transform: translateX(8px);\n}\n\n.back-disc.progress {\n  background: var(--lavender-tint);\n  color: var(--lavender);\n}\n\n.gesture-meter {\n  position: absolute;\n  right: 8px;\n  bottom: 5px;\n  left: 8px;\n  height: 2px;\n  border-radius: 2px;\n  background: var(--stone);\n}\n\n.gesture-meter span {\n  display: block;\n  width: 42%;\n  height: 100%;\n  border-radius: 2px;\n  background: var(--lavender);\n}\n\n.chat-identity {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  flex: 1;\n  gap: 9px;\n  padding-left: 2px;\n}\n\n.chat-identity-copy {\n  min-width: 0;\n}\n\n.chat-identity-name {\n  overflow: hidden;\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.chat-status {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  margin-top: 3px;\n  color: var(--sage);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.status-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--sage);\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  margin-left: 2px;\n}\n\n.header-icon {\n  width: 42px;\n  color: var(--graphite);\n}\n\n.chat-thread {\n  position: relative;\n  min-height: 435px;\n  padding: 15px 12px 10px;\n  transform: translateX(10px);\n  opacity: .97;\n}\n\n.rail-seam {\n  position: absolute;\n  top: 10px;\n  bottom: 12px;\n  left: 20px;\n  width: 1px;\n  background: var(--border);\n}\n\n.motion-caption {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin: 0 14px 10px;\n  color: var(--muted);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .11em;\n  text-transform: uppercase;\n}\n\n.motion-caption strong {\n  color: var(--lavender);\n  font-weight: 700;\n}\n\n.day-rule {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin: 4px 8px 18px;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 600;\n  text-align: center;\n}\n\n.day-rule::before,\n.day-rule::after {\n  height: 1px;\n  flex: 1;\n  background: var(--border);\n  content: '';\n}\n\n.message {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  margin: 0 3px 10px;\n}\n\n.message.incoming {\n  justify-content: flex-start;\n}\n\n.message.outgoing {\n  justify-content: flex-end;\n}\n\n.message-cluster {\n  max-width: 78%;\n}\n\n.message.outgoing .message-cluster {\n  align-items: flex-end;\n}\n\n.sender {\n  margin: 0 0 4px 8px;\n  color: var(--graphite);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.bubble {\n  padding: 9px 11px 8px;\n  border-radius: 12px 12px 12px 4px;\n  color: var(--graphite);\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 1.42;\n}\n\n.message.outgoing .bubble {\n  border-radius: 12px 12px 4px 12px;\n  background: var(--lavender-tint);\n}\n\n.message.incoming .bubble {\n  background: var(--stone);\n}\n\n.bubble-meta {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 3px;\n  margin-top: 5px;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n\n.bubble-meta i {\n  color: var(--lavender);\n  font-size: 13px;\n}\n\n.reply-snippet {\n  margin: 0 0 8px;\n  padding: 5px 8px;\n  border-left: 2px solid var(--lavender);\n  background: rgba(255,255,255,.44);\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n.reply-snippet strong {\n  display: block;\n  color: var(--graphite);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.reaction {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  margin: -4px 0 0 10px;\n  padding: 3px 7px;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--white);\n  color: var(--graphite);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.reaction i {\n  color: var(--lavender);\n  font-size: 11px;\n}\n\n.file-bubble {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding: 9px;\n  border: 1px solid rgba(41,40,45,.08);\n  border-radius: 10px 10px 10px 4px;\n  background: var(--white);\n}\n\n.file-mark {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border-radius: 8px;\n  background: var(--stone);\n  color: var(--muted);\n  font-size: 16px;\n}\n\n.file-copy strong,\n.file-copy span {\n  display: block;\n}\n\n.file-copy strong {\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.file-copy span {\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.typing-line {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  align-items: flex-end;\n  gap: 7px;\n  margin: 2px 0 10px 3px;\n}\n\n.typing-bubble {\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  height: 30px;\n  padding: 0 10px;\n  border-radius: 12px 12px 12px 4px;\n  background: var(--stone);\n}\n\n.typing-bubble span {\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  background: var(--muted);\n}\n\n.typing-bubble span:nth-child(2) { opacity: .68; }\n.typing-bubble span:nth-child(3) { opacity: .38; }\n\n.failed-meta {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 4px;\n  margin-top: 4px;\n  color: var(--danger);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.failed-meta i { font-size: 12px; }\n\n.composer-wrap {\n  position: relative;\n  z-index: 2;\n  padding: 9px 12px 11px;\n  background: var(--pearl);\n}\n\n.composer {\n  display: flex;\n  align-items: center;\n  min-height: 58px;\n  padding: 4px 4px 4px 1px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--white);\n  box-shadow: 0 3px 12px rgba(41,40,45,.06);\n}\n\n.composer-target {\n  width: 44px;\n  height: 48px;\n  color: var(--muted);\n  font-size: 19px;\n}\n\n.composer-input {\n  min-width: 0;\n  flex: 1;\n  padding: 0 6px;\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.send-target {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 48px;\n  height: 48px;\n}\n\n.send-circle {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: var(--lavender);\n  color: var(--white);\n  font-size: 17px;\n}\n\n.flow-block {\n  padding: 14px 14px 0;\n}\n\n.flow-block + .flow-block {\n  margin-top: 12px;\n  border-top: 1px solid var(--border);\n}\n\n.mini-topbar {\n  display: flex;\n  align-items: center;\n  min-height: 48px;\n  margin: -2px -4px 4px;\n}\n\n.mini-topbar .back-disc {\n  width: 28px;\n  height: 28px;\n}\n\n.mini-topbar .back-disc i {\n  font-size: 17px;\n  transform: none;\n}\n\n.mini-topbar h2 {\n  margin: 0 0 0 9px;\n  font-size: 18px;\n  font-weight: 500;\n  letter-spacing: -.035em;\n}\n\n.mini-topbar .top-status {\n  margin-left: auto;\n  color: var(--lavender);\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.selection-search {\n  height: 44px;\n  margin: 5px 0 12px;\n  padding: 0 12px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--stone);\n}\n\n.selection-search span { font-size: 12px; }\n\n.assembly-label {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin: 2px 0 7px;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n}\n\n.assembly-label strong {\n  color: var(--graphite);\n  font-weight: 700;\n  letter-spacing: 0;\n  text-transform: none;\n}\n\n.assembly-strip {\n  display: flex;\n  align-items: center;\n  min-height: 43px;\n  margin-bottom: 10px;\n}\n\n.assembly-strip .avatar {\n  margin-left: -7px;\n  border: 2px solid var(--pearl);\n}\n\n.assembly-strip .avatar:first-child { margin-left: 0; }\n\n.assembly-more {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  margin-left: -7px;\n  border: 2px solid var(--pearl);\n  border-radius: 50%;\n  background: var(--stone);\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.member-row {\n  display: flex;\n  align-items: center;\n  min-height: 60px;\n  border-top: 1px solid var(--border);\n}\n\n.member-row:first-of-type { border-top: 0; }\n\n.member-copy {\n  min-width: 0;\n  flex: 1;\n  margin-left: 11px;\n}\n\n.member-name {\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.member-handle {\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.check {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  color: transparent;\n  font-size: 15px;\n}\n\n.check.checked {\n  border-color: var(--lavender);\n  background: var(--lavender);\n  color: var(--white);\n}\n\n.selection-shelf {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 61px;\n  margin: 10px -14px 0;\n  padding: 0 14px;\n  border-top: 1px solid var(--border);\n  background: var(--white);\n}\n\n.selection-shelf strong {\n  display: block;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.selection-shelf span {\n  display: block;\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.next-action,\n.primary-action {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  height: 40px;\n  padding: 0 14px;\n  border-radius: 8px;\n  background: var(--lavender);\n  color: var(--white);\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.next-action i { font-size: 15px; }\n\n.details-preview {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 5px 0 13px;\n  text-align: center;\n}\n\n.details-preview .mosaic { margin-bottom: 8px; }\n\n.details-preview strong {\n  font-size: 17px;\n  font-weight: 600;\n  letter-spacing: -.03em;\n}\n\n.details-preview span {\n  margin-top: 3px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.form-well {\n  min-height: 48px;\n  margin: 8px 0;\n  padding: 8px 11px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--stone);\n}\n\n.form-well.focused {\n  border-color: var(--lavender);\n  background: var(--white);\n}\n\n.form-well label {\n  display: block;\n  color: var(--muted);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .05em;\n  text-transform: uppercase;\n}\n\n.form-well strong {\n  display: block;\n  margin-top: 3px;\n  color: var(--graphite);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.form-well p {\n  margin: 3px 0 0;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.review-label,\n.section-title {\n  margin: 13px 0 4px;\n  color: var(--muted);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .11em;\n  text-transform: uppercase;\n}\n\n.create-shelf {\n  display: flex;\n  justify-content: flex-end;\n  margin: 12px -14px 0;\n  padding: 10px 14px;\n  border-top: 1px solid var(--border);\n  background: var(--white);\n}\n\n.group-info-block,\n.profile-block {\n  padding: 16px 16px 0;\n}\n\n.group-info-hero {\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  padding: 2px 0 15px;\n}\n\n.group-info-copy h2,\n.profile-copy h2 {\n  margin: 0;\n  font-size: 23px;\n  font-weight: 500;\n  letter-spacing: -.045em;\n}\n\n.group-info-copy p,\n.profile-copy p {\n  margin: 4px 0 0;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.group-description {\n  margin: 0 0 13px;\n  color: var(--graphite);\n  font-size: 12px;\n  line-height: 1.48;\n}\n\n.info-section {\n  border-top: 1px solid var(--border);\n}\n\n.info-section .section-title { margin: 12px 0 2px; }\n\n.info-row {\n  display: flex;\n  align-items: center;\n  min-height: 49px;\n  border-top: 1px solid var(--border);\n}\n\n.info-row:first-of-type { border-top: 0; }\n\n.info-row i {\n  width: 25px;\n  color: var(--muted);\n  font-size: 17px;\n}\n\n.info-row-copy {\n  min-width: 0;\n  flex: 1;\n}\n\n.info-row-copy strong {\n  display: block;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.info-row-copy span {\n  display: block;\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.info-row > .ti-chevron-right {\n  width: auto;\n  color: 