      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.board {\n  --pearl: #F7F7F5;\n  --white: #FFFFFF;\n  --stone: #EEEDEA;\n  --graphite: #29282D;\n  --muted: #77757D;\n  --border: #E3E2E5;\n  --lavender: #8D88C7;\n  --lavender-tint: #EAE8F5;\n  --sage: #88A99A;\n  --danger: #B85F66;\n  width: 100%;\n  min-height: 100vh;\n  overflow-x: hidden;\n  background: var(--pearl);\n  color: var(--graphite);\n  font-family: 'Manrope', sans-serif;\n  letter-spacing: -0.01em;\n}\n.board, .board * { box-sizing: border-box; }\n.board i { line-height: 1; }\n.snapshot {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  border-bottom: 1px solid var(--border);\n  background: var(--pearl);\n}\n.snapshot-home { min-height: 800px; }\n.snapshot-chat { min-height: 1120px; }\n.snapshot-group { min-height: 1280px; }\n.snapshot-utilities { min-height: 1500px; }\n.snapshot-profile { min-height: 870px; }\n.snapshot-auth { min-height: 930px; }\n.snapshot-states { min-height: 520px; border-bottom: 0; }\n.board-caption {\n  padding: 22px 20px 10px;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 14px;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n.board-caption span { color: var(--lavender); }\n.status {\n  display: flex;\n  height: 26px;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 20px;\n  color: var(--graphite);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n}\n.status-icons { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; }\n.top-safe { padding-top: 7px; }\n.home-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  padding: 26px 20px 18px 24px;\n}\n.home-head h1, .auth-head h1 { margin: 0; font-size: 36px; line-height: 42px; font-weight: 400; letter-spacing: -0.065em; }\n.home-sub { margin-top: 5px; color: var(--muted); font-size: 12px; line-height: 16px; font-weight: 500; }\n.home-actions { display: flex; align-items: center; gap: 5px; padding-top: 3px; }\n.icon-target {\n  display: grid;\n  width: 48px;\n  height: 48px;\n  place-items: center;\n  color: var(--graphite);\n  font-size: 20px;\n}\n.icon-target.quiet { color: var(--muted); }\n.icon-target.lav { color: var(--lavender); }\n.avatar {\n  position: relative;\n  display: grid;\n  flex: none;\n  width: 42px;\n  height: 42px;\n  place-items: center;\n  overflow: visible;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: var(--stone);\n  color: var(--graphite);\n  font-size: 14px;\n  font-weight: 700;\n}\n.avatar.small { width: 34px; height: 34px; font-size: 11px; }\n.avatar.large { width: 82px; height: 82px; font-size: 25px; }\n.avatar.maya { background: var(--lavender-tint); }\n.avatar.olive { background: var(--stone); }\n.presence {\n  position: absolute;\n  right: -1px;\n  bottom: 0;\n  width: 10px;\n  height: 10px;\n  border: 2px solid var(--pearl);\n  border-radius: 50%;\n  background: var(--sage);\n}\n.search-field {\n  display: flex;\n  height: 48px;\n  align-items: center;\n  gap: 10px;\n  margin: 0 16px 16px;\n  padding: 0 14px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--white);\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 500;\n}\n.search-field i { font-size: 18px; }\n.conversation-list { padding: 2px 8px 96px; }\n.conversation-row {\n  position: relative;\n  display: flex;\n  min-height: 76px;\n  align-items: center;\n  gap: 14px;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n}\n.conversation-row:last-child { border-bottom: 0; }\n.conversation-row.selected {\n  border-bottom-color: transparent;\n  border-radius: 10px;\n  background: var(--lavender-tint);\n}\n.conversation-row.selected:before {\n  position: absolute;\n  left: 3px;\n  bottom: 18px;\n  width: 3px;\n  height: 14px;\n  border-radius: 3px;\n  background: var(--lavender);\n  content: '';\n}\n.row-copy { min-width: 0; flex: 1; }\n.row-top, .row-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.row-top { margin-bottom: 5px; }\n.row-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; line-height: 20px; font-weight: 700; }\n.row-time { flex: none; color: var(--muted); font-size: 11px; line-height: 16px; font-weight: 600; }\n.row-preview { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 12px; line-height: 17px; font-weight: 500; }\n.row-preview strong { color: var(--graphite); font-weight: 600; }\n.unread { display: grid; width: 22px; height: 22px; flex: none; place-items: center; border-radius: 50%; background: var(--stone); color: var(--graphite); font-size: 10px; font-weight: 700; }\n.group-mosaic { position: relative; display: grid; width: 42px; height: 42px; flex: none; grid-template-columns: 1fr 1fr; gap: 2px; overflow: hidden; border: 1px solid var(--border); border-radius: 50%; background: var(--stone); padding: 7px; }\n.group-mosaic span { display: grid; place-items: center; border-radius: 50%; background: var(--white); color: var(--graphite); font-size: 7px; font-weight: 700; }\n.group-mosaic span:nth-child(2), .group-mosaic span:nth-child(3) { background: var(--lavender-tint); }\n.group-mosaic.large { width: 92px; height: 92px; padding: 15px; gap: 3px; }\n.group-mosaic.large span { font-size: 11px; }\n.bottom-nav {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  display: flex;\n  height: 76px;\n  align-items: center;\n  justify-content: space-around;\n  border-top: 1px solid var(--border);\n  background: var(--white);\n  padding: 7px 22px 11px;\n}\n.nav-item { display: flex; width: 76px; height: 58px; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: var(--muted); font-size: 10px; font-weight: 600; }\n.nav-item i { display: grid; width: 28px; height: 24px; place-items: center; border-radius: 8px; font-size: 19px; }\n.nav-item.active { color: var(--graphite); }\n.nav-item.active i { background: var(--lavender-tint); color: var(--lavender); }\n\n.chat-shell { position: relative; min-height: 1120px; }\n.chat-header {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  height: 72px;\n  align-items: center;\n  gap: 3px;\n  padding: 0 10px 0 4px;\n  border-bottom: 1px solid var(--border);\n  background: var(--pearl);\n}\n.drag-control { position: relative; display: grid; width: 48px; height: 48px; place-items: center; }\n.drag-disc { position: relative; display: grid; width: 32px; height: 32px; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: var(--stone); color: var(--graphite); font-size: 18px; transform: translateX(7px); }\n.drag-disc:after { position: absolute; right: -7px; top: 8px; width: 3px; height: 15px; border-radius: 3px; background: var(--lavender); content: ''; opacity: 0.75; }\n.identity { display: flex; min-width: 0; flex: 1; align-items: center; gap: 9px; }\n.identity-copy { min-width: 0; }\n.identity-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 16px; line-height: 21px; font-weight: 700; }\n.identity-status { display: flex; align-items: center; gap: 5px; margin-top: 2px; color: var(--sage); font-size: 11px; line-height: 15px; font-weight: 600; }\n.status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sage); }\n.header-actions { display: flex; align-items: center; }\n.header-actions .icon-target { width: 44px; height: 48px; font-size: 18px; }\n.thread-seam { position: absolute; top: 72px; bottom: 104px; left: 20px; width: 1px; background: var(--border); opacity: 0.8; }\n.thread-seam:after { position: absolute; top: 28px; left: -1px; width: 3px; height: 11px; border-radius: 3px; background: var(--lavender); content: ''; opacity: 0.55; }\n.drag-progress { display: flex; height: 20px; align-items: center; gap: 7px; padding: 6px 20px 0; color: var(--muted); font-size: 9px; font-weight: 600; }\n.progress-track { position: relative; width: 48px; height: 2px; border-radius: 2px; background: var(--stone); }\n.progress-track:after { position: absolute; left: 0; top: 0; width: 19px; height: 2px; border-radius: 2px; background: var(--lavender); content: ''; }\n.date-rule { display: flex; align-items: center; gap: 10px; margin: 23px 20px 18px; color: var(--muted); font-size: 10px; line-height: 14px; font-weight: 700; }\n.date-rule:before, .date-rule:after { height: 1px; flex: 1; background: var(--border); content: ''; }\n.thread { position: relative; padding: 0 16px 135px; }\n.message { display: flex; align-items: flex-end; gap: 7px; margin: 0 0 10px; }\n.message.incoming { justify-content: flex-start; }\n.message.outgoing { justify-content: flex-end; }\n.sender-mark { display: grid; width: 24px; height: 24px; flex: none; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: var(--lavender-tint); color: var(--graphite); font-size: 8px; font-weight: 700; }\n.bubble-wrap { max-width: 78%; }\n.sender-label { margin: 0 0 4px 4px; color: var(--graphite); font-size: 11px; line-height: 14px; font-weight: 700; }\n.bubble { position: relative; padding: 10px 12px 7px; border-radius: 13px; font-size: 14px; line-height: 20px; font-weight: 500; }\n.bubble.in { border-bottom-left-radius: 4px; background: var(--stone); }\n.bubble.out { border-bottom-right-radius: 4px; background: var(--lavender-tint); }\n.bubble-meta { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin-top: 5px; color: var(--muted); font-size: 10px; line-height: 13px; font-weight: 600; }\n.bubble-meta i { color: var(--lavender); font-size: 12px; }\n.reply-strip { margin: 0 0 8px; padding: 5px 8px 6px; border-left: 2px solid var(--lavender); border-radius: 0 6px 6px 0; background: rgba(255,255,255,0.55); color: var(--muted); font-size: 10px; line-height: 13px; }\n.reply-strip strong { display: block; margin-bottom: 2px; color: var(--graphite); font-size: 10px; font-weight: 700; }\n.reaction { display: inline-flex; align-items: center; gap: 4px; margin: 4px 0 0 8px; padding: 3px 7px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); color: var(--graphite); font-size: 11px; line-height: 13px; font-weight: 600; }\n.media-message { overflow: hidden; border: 1px solid var(--border); border-radius: 13px 13px 4px 13px; background: var(--white); }\n.media-thumb { display: flex; height: 94px; align-items: flex-end; justify-content: space-between; padding: 9px; background: var(--stone); color: var(--graphite); }\n.media-thumb .ti-photo { font-size: 27px; color: var(--muted); }\n.media-thumb em { font-style: normal; color: var(--muted); font-size: 10px; font-weight: 700; }\n.media-caption { padding: 7px 10px 8px; color: var(--graphite); font-size: 12px; line-height: 16px; font-weight: 600; }\n.file-row { display: flex; min-width: 220px; align-items: center; gap: 9px; padding: 10px 11px; border: 1px solid var(--border); border-radius: 12px 12px 4px 12px; background: var(--white); }\n.file-icon { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 8px; background: var(--stone); color: var(--muted); font-size: 16px; }\n.file-copy { min-width: 0; flex: 1; }\n.file-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--graphite); font-size: 11px; line-height: 15px; font-weight: 700; }\n.file-size { color: var(--muted); font-size: 10px; line-height: 13px; font-weight: 500; }\n.typing { display: flex; align-items: flex-end; gap: 7px; margin: 14px 0 0 0; }\n.typing-bubble { display: flex; height: 32px; align-items: center; gap: 4px; padding: 0 11px; border-radius: 13px 13px 13px 4px; background: var(--stone); }\n.typing-bubble span { width: 4px; height: 4px; border-radius: 50%; background: var(--muted); }\n.typing-bubble span:nth-child(2) { opacity: 0.65; }\n.typing-bubble span:nth-child(3) { opacity: 0.35; }\n.composer {\n  position: absolute;\n  right: 12px;\n  bottom: 16px;\n  left: 12px;\n  display: flex;\n  min-height: 60px;\n  align-items: center;\n  gap: 2px;\n  padding: 5px 5px 5px 7px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--white);\n  box-shadow: 0 3px 12px rgba(41,40,45,0.08);\n}\n.composer .icon-target { width: 44px; height: 48px; font-size: 19px; }\n.composer-input { min-width: 0; flex: 1; color: var(--muted); font-size: 13px; line-height: 20px; font-weight: 500; }\n.send-button { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 50%; background: var(--lavender); color: var(--white); font-size: 18px; }\n\n.section-head { display: flex; align-items: center; gap: 12px; padding: 22px 20px 14px; }\n.section-head .icon-target { width: 48px; height: 48px; }\n.section-title { min-width: 0; flex: 1; }\n.section-title h2 { margin: 0; font-size: 21px; line-height: 27px; font-weight: 600; letter-spacing: -0.04em; }\n.section-title p { margin: 3px 0 0; color: var(--muted); font-size: 11px; line-height: 16px; font-weight: 500; }\n.group-chat-frame { position: relative; min-height: 660px; border-top: 1px solid var(--border); }\n.group-info-frame { min-height: 600px; border-top: 1px solid var(--border); }\n.group-count { color: var(--muted); font-size: 11px; font-weight: 600; }\n.group-info-top { display: flex; flex-direction: column; align-items: center; padding: 26px 20px 20px; text-align: center; }\n.group-info-top h2 { margin: 14px 0 2px; font-size: 24px; line-height: 30px; font-weight: 600; letter-spacing: -0.04em; }\n.group-info-top p { margin: 0; color: var(--muted); font-size: 12px; line-height: 17px; font-weight: 500; }\n.group-description { max-width: 285px; margin-top: 12px !important; color: var(--graphite) !important; }\n.flat-section { margin: 0 20px; border-top: 1px solid var(--border); }\n.flat-section-title { padding: 15px 0 8px; color: var(--muted); font-size: 11px; line-height: 15px; font-weight: 700; }\n.member-row, .media-row, .setting-row, .data-row { display: flex; min-height: 58px; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); }\n.member-row:last-child, .setting-row:last-child, .data-row:last-child { border-bottom: 0; }\n.member-copy, .setting-copy { min-width: 0; flex: 1; }\n.member-name, .setting-name { color: var(--graphite); font-size: 13px; line-height: 18px; font-weight: 700; }\n.member-sub, .setting-sub { margin-top: 2px; color: var(--muted); font-size: 11px; line-height: 15px; font-weight: 500; }\n.row-chevron { color: var(--muted); font-size: 17px; }\n.media-row { min-height: 52px; }\n.media-row i { width: 28px; color: var(--muted); font-size: 18px; text-align: center; }\n.media-row span { flex: 1; color: var(--graphite); font-size: 13px; font-weight: 600; }\n.leave-action { display: flex; height: 52px; align-items: center; gap: 10px; margin: 17px 20px 26px; color: var(--danger); font-size: 13px; font-weight: 700; }\n\n.utility-header { display: flex; min-height: 72px; align-items: center; gap: 5px; padding: 0 11px 0 4px; border-bottom: 1px solid var(--border); }\n.utility-header h2 { margin: 0; font-size: 20px; line-height: 26px; font-weight: 600; letter-spacing: -0.04em; }\n.utility-field { margin: 16px 16px 8px; }\n.utility-instruction { padding: 18px 20px 12px; }\n.utility-instruction h3 { margin: 0 0 4px; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: -0.035em; }\n.utility-instruction p { max-width: 300px; margin: 0; color: var(--muted); font-size: 12px; line-height: 18px; font-weight: 500; }\n.result-row { display: flex; min-height: 76px; align-items: center; gap: 12px; margin: 7px 16px 28px; padding: 10px 4px; border-bottom: 1px solid var(--border); }\n.result-copy { min-width: 0; flex: 1; }\n.result-copy strong { display: block; color: var(--graphite); font-size: 14px; line-height: 19px; font-weight: 700; }\n.result-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; line-height: 15px; font-weight: 500; }\n.result-action { display: grid; width: 48px; height: 48px; place-items: center; color: var(--lavender); font-size: 19px; }\n.utility-divider { height: 1px; margin: 0 20px; background: var(--border); }\n.selection-header { padding: 18px 20px 13px; }\n.selection-header h3 { margin: 0; font-size: 20px; line-height: 26px; font-weight: 600; }\n.selection-header p { margin: 3px 0 0; color: var(--muted); font-size: 12px; line-height: 16px; font-weight: 500; }\n.selected-rail { display: flex; min-height: 63px; align-items: center; gap: 0; padding: 0 20px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n.rail-avatar { margin-right: -7px; border: 2px solid var(--pearl); }\n.rail-more { display: grid; width: 34px; height: 34px; margin-left: 9px; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: var(--white); color: var(--muted); font-size: 10px; font-weight: 700; }\n.directory-label { padding: 18px 20px 6px; color: var(--muted); font-size: 11px; line-height: 15px; font-weight: 700; }\n.select-row { display: flex; min-height: 68px; align-items: center; gap: 12px; padding: 7px 20px; border-bottom: 1px solid var(--border); }\n.select-row .row-copy { flex: 1; }\n.select-check { display: grid; width: 26px; height: 26px; place-items: center; border: 1px solid var(--border); border-radius: 50%; color: transparent; font-size: 15px; }\n.select-row.selected .select-check { border-color: var(--lavender); background: var(--lavender); color: var(--white); }\n.selection-action { display: flex; min-height: 66px; align-items: center; justify-content: space-between; padding: 9px 20px; border-top: 1px solid var(--border); background: var(--white); }\n.selection-action span { color: var(--muted); font-size: 12px; font-weight: 600; }\n.next-action { display: flex; height: 44px; align-items: center; gap: 7px; padding: 0 13px; border-radius: 10px; background: var(--lavender); color: var(--white); font-size: 12px; font-weight: 700; }\n.group-details { border-top: 1px solid var(--border); }\n.group-details-head { display: flex; align-items: center; gap: 5px; padding: 17px 11px 0 4px; }\n.group-details-head .icon-target { width: 48px; height: 48px; }\n.group-details-head h3 { margin: 0; font-size: 20px; line-height: 26px; font-weight: 600; }\n.group-identity { display: flex; flex-direction: column; align-items: center; padding: 17px 20px 20px; }\n.group-identity p { margin: 10px 0 0; color: var(--muted); font-size: 12px; font-weight: 600; }\n.form-stack { padding: 0 20px; }\n.form-field { min-height: 58px; margin-bottom: 12px; padding: 8px 12px 6px; border: 1px solid var(--border); border-radius: 8px; background: var(--white); }\n.form-label { display: block; color: var(--muted); font-size: 10px; line-height: 14px; font-weight: 700; }\n.form-value { display: block; margin-top: 4px; color: var(--graphite); font-size: 13px; line-height: 18px; font-weight: 600; }\n.form-value.placeholder { color: var(--muted); font-weight: 500; }\n.review-label { padding: 5px 0 6px; color: var(--muted); font-size: 11px; line-height: 15px; font-weight: 700; }\n.review-person { display: flex; height: 51px; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); }\n.review-person span { color: var(--graphite); font-size: 12px; font-weight: 600; }\n.create-surface { margin-top: 16px; padding: 12px 20px 16px; border-top: 1px solid var(--border); background: var(--white); }\n.primary-action { display: flex; height: 50px; align-items: center; justify-content: center; border-radius: 10px; background: var(--lavender); color: var(--white); font-size: 13px; font-weight: 700; }\n\n.profile-header { display: flex; align-items: center; gap: 16px; padding: 27px 20px 21px; }\n.profile-copy