ted)]\" data-kid=\"2-5-5-5-2-1\" data-name=\"email field label\">\n                        Email\n                    </div>\n                    <div class=\"mt-0.5 truncate text-[13px] font-[600]\" data-kid=\"2-5-5-5-2-2\" data-name=\"email field value\">\n                        alex@example.com\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"section-label mx-5 mt-7 mb-2\" data-kid=\"2-5-6\" data-name=\"section label\">\n            Preferences\n        </div>\n        <div class=\"grouped-list\" data-kid=\"2-5-7\" data-name=\"preferences settings group\">\n            <div class=\"flex items-center gap-3 px-5 py-3\" data-kid=\"2-5-7-1\" data-name=\"notifications settings row\">\n                <i class=\"ti ti-bell icon\" data-kid=\"2-5-7-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;color:var(--muted)\">\n                </i>\n                <div class=\"flex-1 text-[13px] font-[600]\" data-kid=\"2-5-7-1-2\" data-name=\"notifications label\">\n                    Notifications\n                </div>\n                <i class=\"ti ti-chevron-right icon\" data-kid=\"2-5-7-1-3\" data-name=\"chevron icon\" style=\"width:17px;height:17px;color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"soft-rule ml-[59px]\" data-kid=\"2-5-7-2\" data-name=\"soft divider line\">\n            </div>\n            <div class=\"flex items-center gap-3 px-5 py-3\" data-kid=\"2-5-7-3\" data-name=\"privacy settings row\">\n                <i class=\"ti ti-lock icon\" data-kid=\"2-5-7-3-1\" data-name=\"lock icon\" style=\"width:19px;height:19px;color:var(--muted)\">\n                </i>\n                <div class=\"flex-1 text-[13px] font-[600]\" data-kid=\"2-5-7-3-2\" data-name=\"privacy label\">\n                    Privacy\n                </div>\n                <i class=\"ti ti-chevron-right icon\" data-kid=\"2-5-7-3-3\" data-name=\"chevron icon\" style=\"width:17px;height:17px;color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"soft-rule ml-[59px]\" data-kid=\"2-5-7-4\" data-name=\"soft divider line\">\n            </div>\n            <div class=\"flex items-center gap-3 px-5 py-3\" data-kid=\"2-5-7-5\" data-name=\"appearance settings row\">\n                <i class=\"ti ti-adjustments-horizontal icon\" data-kid=\"2-5-7-5-1\" data-name=\"adjustments icon\" style=\"width:19px;height:19px;color:var(--muted)\">\n                </i>\n                <div class=\"flex-1 text-[13px] font-[600]\" data-kid=\"2-5-7-5-2\" data-name=\"appearance label\">\n                    Appearance\n                </div>\n                <span class=\"text-[11px] text-[var(--muted)]\" data-kid=\"2-5-7-5-3\" data-name=\"appearance value label\">\n                    Light\n                </span>\n                <i class=\"ti ti-chevron-right icon\" data-kid=\"2-5-7-5-4\" data-name=\"chevron icon\" style=\"width:17px;height:17px;color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"soft-rule ml-[59px]\" data-kid=\"2-5-7-6\" data-name=\"soft divider line\">\n            </div>\n            <div class=\"flex items-center gap-3 px-5 py-3\" data-kid=\"2-5-7-7\" data-name=\"data storage settings row\">\n                <i class=\"ti ti-database icon\" data-kid=\"2-5-7-7-1\" data-name=\"database icon\" style=\"width:19px;height:19px;color:var(--muted)\">\n                </i>\n                <div class=\"flex-1 text-[13px] font-[600]\" data-kid=\"2-5-7-7-2\" data-name=\"data storage label\">\n                    Data & storage\n                </div>\n                <i class=\"ti ti-chevron-right icon\" data-kid=\"2-5-7-7-3\" data-name=\"chevron icon\" style=\"width:17px;height:17px;color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"soft-rule ml-[59px]\" data-kid=\"2-5-7-8\" data-name=\"soft divider line\">\n            </div>\n            <div class=\"flex items-center gap-3 px-5 py-3\" data-kid=\"2-5-7-9\" data-name=\"about settings row\">\n                <i class=\"ti ti-info-circle icon\" data-kid=\"2-5-7-9-1\" data-name=\"info circle icon\" style=\"width:19px;height:19px;color:var(--muted)\">\n                </i>\n                <div class=\"flex-1 text-[13px] font-[600]\" data-kid=\"2-5-7-9-2\" data-name=\"about label\">\n                    About YOKOSU\n                </div>\n                <i class=\"ti ti-chevron-right icon\" data-kid=\"2-5-7-9-3\" data-name=\"chevron icon\" style=\"width:17px;height:17px;color:var(--muted)\">\n                </i>\n            </div>\n        </div>\n        <div class=\"mt-7 px-5 text-center text-[12px] font-[650] text-[var(--danger)]\" data-kid=\"2-5-8\" data-name=\"sign out button\">\n            Sign out\n        </div>\n    </section>\n    <!-- 05 Authentication / profile setup -->\n    <section class=\"border-t border-[var(--border)] bg-[var(--pearl)] pb-6 pt-5\" data-kid=\"2-6\" data-name=\"auth routes section\">\n        <div class=\"px-5\" data-kid=\"2-6-1\" data-name=\"route info header\">\n            <div class=\"flex items-center justify-between\" data-kid=\"2-6-1-1\" data-name=\"header information container\">\n                <div class=\"route-kicker\" data-kid=\"2-6-1-1-1\" data-name=\"route kicker label\">\n                    05 / auth routes\n                </div>\n                <div class=\"text-[10px] font-medium text-[var(--muted)]\" data-kid=\"2-6-1-1-2\" data-name=\"screen route identifier\">\n                    SignIn · register · UserInfo\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-5 px-7 pt-5\" data-kid=\"2-6-2\" data-name=\"signin screen container\">\n            <div class=\"flex items-center gap-2\" data-kid=\"2-6-2-1\" data-name=\"signin screen logo\">\n                <div class=\"text-[17px] font-[650] tracking-[0.02em]\" data-kid=\"2-6-2-1-1\" data-name=\"signin screen brand name\">\n                    YOKOSU\n                </div>\n                <div class=\"mt-3 h-[2px] w-5 rounded-full bg-[var(--lavender)]\" data-kid=\"2-6-2-1-2\" data-name=\"brand underline decoration\">\n                </div>\n            </div>\n            <div class=\"mt-3 text-[27px] font-[350] leading-[33px] tracking-[-0.045em]\" data-kid=\"2-6-2-2\" data-name=\"signin welcome headline\">\n                Welcome back.\n            </div>\n            <div class=\"mt-1 text-[12px] leading-[17px] text-[var(--muted)]\" data-kid=\"2-6-2-3\" data-name=\"signin subheadline\">\n                Sign in to continue your conversations.\n            </div>\n            <div class=\"auth-field mt-7 px-4 py-2.5\" data-kid=\"2-6-2-4\" data-name=\"email field\">\n                <div class=\"text-[10px] font-[650] text-[var(--muted)]\" data-kid=\"2-6-2-4-1\" data-name=\"email field label\">\n                    Email address\n                </div>\n                <div class=\"mt-1 text-[13px] text-[var(--graphite)]\" data-kid=\"2-6-2-4-2\" data-name=\"email field input value\">\n                    alex@example.com\n                </div>\n            </div>\n            <div class=\"auth-field mt-3 flex items-center px-4 py-2.5\" data-kid=\"2-6-2-5\" data-name=\"password field\">\n                <div class=\"min-w-0 flex-1\" data-kid=\"2-6-2-5-1\" data-name=\"password field inner container\">\n                    <div class=\"text-[10px] font-[650] text-[var(--muted)]\" data-kid=\"2-6-2-5-1-1\" data-name=\"password label\">\n                        Password\n                    </div>\n                    <div class=\"mt-1 text-[13px] tracking-[0.16em] text-[var(--graphite)]\" data-kid=\"2-6-2-5-1-2\" data-name=\"password value\">\n                        ••••••••\n                    </div>\n                </div>\n                <i class=\"ti ti-eye icon\" data-kid=\"2-6-2-5-2\" data-name=\"password eye icon\" style=\"width:18px;height:18px;color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"mt-4 flex justify-end text-[11px] font-[600] text-[var(--muted)]\" data-kid=\"2-6-2-6\" data-name=\"forgot password link\">\n                Forgot password?\n            </div>\n            <div class=\"mt-5 flex h-[52px] items-center justify-center rounded-[10px] bg-[var(--lavender)] text-[14px] font-[650] text-[var(--white)]\" data-kid=\"2-6-2-7\" data-name=\"signin action button\">\n                Sign in\n            </div>\n            <div class=\"mt-5 text-center text-[12px] text-[var(--muted)]\" data-kid=\"2-6-2-8\" data-name=\"create account prompt\">\n                Don’t have an account?\n                <span class=\"font-[650] text-[var(--graphite)] underline decoration-[var(--border)] underline-offset-4\" data-kid=\"2-6-2-8-1\" data-name=\"create account link\">\n                    Create account\n                </span>\n            </div>\n        </div>\n        <div class=\"mx-7 mt-8 border-t border-[var(--border)] pt-6\" data-kid=\"2-6-3\" data-name=\"after register screen\">\n            <div class=\"route-kicker\" data-kid=\"2-6-3-1\" data-name=\"route kicker label\">\n                after register\n            </div>\n            <div class=\"mt-3 text-[23px] font-[350] leading-[29px] tracking-[-0.04em]\" data-kid=\"2-6-3-2\" data-name=\"after register headline\">\n                Set up your profile.\n            </div>\n            <div class=\"mt-1 text-[12px] leading-[17px] text-[var(--muted)]\" data-kid=\"2-6-3-3\" data-name=\"after register description\">\n                This is how people will find you.\n            </div>\n            <div class=\"mt-5 grid grid-cols-2 gap-3\" data-kid=\"2-6-3-4\" data-name=\"profile fields grid\">\n                <div class=\"auth-field px-3 py-2.5\" data-kid=\"2-6-3-4-1\" data-name=\"name field container\">\n                    <div class=\"text-[10px] font-[650] text-[var(--muted)]\" data-kid=\"2-6-3-4-1-1\" data-name=\"name field label\">\n                        Your name\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"2-6-3-4-1-2\" data-name=\"name field value\">\n                        Alex Morgan\n                    </div>\n                </div>\n                <div class=\"auth-field px-3 py-2.5\" data-kid=\"2-6-3-4-2\" data-name=\"username field container\">\n                    <div class=\"text-[10px] font-[650] text-[var(--muted)]\" data-kid=\"2-6-3-4-2-1\" data-name=\"username field label\">\n                        Username\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"2-6-3-4-2-2\" data-name=\"username field value\">\n                        @alexmorgan\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 flex h-[52px] items-center justify-center rounded-[10px] bg-[var(--lavender)] text-[14px] font-[650] text-[var(--white)]\" data-kid=\"2-6-3-5\" data-name=\"create profile action button\">\n                Create profile\n            </div>\n            <div class=\"mt-2 text-center text-[10px] text-[var(--muted)]\" data-kid=\"2-6-3-6\" data-name=\"loading state design note\">\n                Loading state keeps the button geometry and swaps in a quiet progress mark.\n            </div>\n        </div>\n    </section>\n    <!-- 06 Compact state strip -->\n    <section class=\"border-t border-[var(--border)] bg-[var(--pearl)] px-5 pb-8 pt-5\" data-kid=\"2-7\" data-name=\"compact state strip section\">\n        <div class=\"flex items-center justify-between\" data-kid=\"2-7-1\" data-name=\"section header\">\n            <div class=\"route-kicker\" data-kid=\"2-7-1-1\" data-name=\"route kicker label\">\n                06 / states at a glance\n            </div>\n            <div class=\"text-[10px] font-medium text-[var(--muted)]\" data-kid=\"2-7-1-2\" data-name=\"state identification\">\n                literal · quiet · actionable\n            </div>\n        </div>\n        <div class=\"mt-3 grid grid-cols-2 gap-2\" data-kid=\"2-7-2\" data-name=\"states grid container\">\n            <div class=\"state-mini flex flex-col justify-between p-3\" data-kid=\"2-7-2-1\" data-name=\"no messages state card\">\n                <i class=\"ti ti-message-off icon\" data-kid=\"2-7-2-1-1\" data-name=\"no messages icon\" style=\"width:20px;height:20px;color:var(--muted)\">\n                </i>\n                <div data-kid=\"2-7-2-1-2\" data-name=\"card text container\">\n                    <div class=\"text-[12px] font-[650] leading-[16px]\" data-kid=\"2-7-2-1-2-1\" data-name=\"card title\">\n                        No messages yet\n                    </div>\n                    <div class=\"mt-1 text-[10px] leading-[14px] text-[var(--muted)]\" data-kid=\"2-7-2-1-2-2\" data-name=\"card description\">\n                        Write the first message.\n                    </div>\n                </div>\n            </div>\n            <div class=\"state-mini flex flex-col justify-between p-3\" data-kid=\"2-7-2-2\" data-name=\"loading state card\">\n                <div class=\"flex gap-1\" data-kid=\"2-7-2-2-1\" data-name=\"loading skeleton container\">\n                    <span class=\"skeleton-line h-2 w-12\" data-kid=\"2-7-2-2-1-1\" data-name=\"skeleton line 1\">\n                    </span>\n                    <span class=\"skeleton-line h-2 w-6\" data-kid=\"2-7-2-2-1-2\" data-name=\"skeleton line 2\">\n                    </span>\n                </div>\n                <div data-kid=\"2-7-2-2-2\" data-name=\"card text container\">\n                    <div class=\"text-[12px] font-[650] leading-[16px]\" data-kid=\"2-7-2-2-2-1\" data-name=\"card title\">\n                        Loading messages\n                    </div>\n                    <div class=\"mt-1 text-[10px] leading-[14px] text-[var(--muted)]\" data-kid=\"2-7-2-2-2-2\" data-name=\"card description\">\n                        Rows keep their final shape.\n                    </div>\n                </div>\n            </div>\n            <div class=\"state-mini flex flex-col justify-between p-3\" data-kid=\"2-7-2-3\" data-name=\"error state card\">\n                <i class=\"ti ti-refresh-alert icon\" data-kid=\"2-7-2-3-1\" data-name=\"error icon\" style=\"width:20px;height:20px;color:var(--muted)\">\n                </i>\n                <div data-kid=\"2-7-2-3-2\" data-name=\"card text container\">\n                    <div class=\"text-[12px] font-[650] leading-[16px]\" data-kid=\"2-7-2-3-2-1\" data-name=\"card title\">\n                        Couldn’t load\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-[650] text-[var(--graphite)] underline decoration-[var(--border)] underline-offset-4\" data-kid=\"2-7-2-3-2-2\" data-name=\"card action link\">\n                        Try again\n                    </div>\n                </div>\n            </div>\n            <div class=\"state-mini flex flex-col justify-between p-3\" data-kid=\"2-7-2-4\" data-name=\"no results state card\">\n                <i class=\"ti ti-user-search icon\" data-kid=\"2-7-2-4-1\" data-name=\"no results icon\" style=\"width:20px;height:20px;color:var(--muted)\">\n                </i>\n                <div data-kid=\"2-7-2-4-2\" data-name=\"card text container\">\n                    <div class=\"text-[12px] font-[650] leading-[16px]\" data-kid=\"2-7-2-4-2-1\" data-name=\"card title\">\n                        No results\n                    </div>\n                    <div class=\"mt-1 text-[10px] leading-[14px] text-[var(--muted)]\" data-kid=\"2-7-2-4-2-2\" data-name=\"card description\">\n                        Check the exact username.\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-5 flex items-start gap-2 border-t border-[var(--border)] pt-4\" data-kid=\"2-7-3\" data-name=\"design system concluding note\">\n            <i class=\"ti ti-sparkles icon\" data-kid=\"2-7-3-1\" data-name=\"sparkles icon\" style=\"width:15px;height:15px;color:var(--lavender)\">\n            </i>\n            <p class=\"m-0 text-[10px] leading-[15px] text-[var(--muted)]\" data-kid=\"2-7-3-2\" data-name=\"system rules description\">\n                System rules carried through every route: Pearl canvas, real data only, one raised surface at a time, 48px touch envelopes, and fast non-bouncy motion.\n            </p>\n        </div>\n    </section>\n</div>\n",
