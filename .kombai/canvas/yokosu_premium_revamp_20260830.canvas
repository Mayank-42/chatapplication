name=\"headline\">\n                    Welcome back\n                </h1>\n                <p data-kid=\"1-6-3-2-2\" data-name=\"subheadline\">\n                    Sign in to return to your conversations.\n                </p>\n            </div>\n            <div class=\"auth-field focused\" data-kid=\"1-6-3-3\" data-name=\"email field\">\n                <i class=\"ti ti-mail\" data-kid=\"1-6-3-3-1\" data-name=\"mail icon\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-3-2\" data-name=\"field copy\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-3-2-1\" data-name=\"label\">\n                        Email address\n                    </div>\n                    <div class=\"auth-field-value\" data-kid=\"1-6-3-3-2-2\" data-name=\"value\">\n                        alex@example.com\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-4\" data-name=\"password field\">\n                <i class=\"ti ti-lock\" data-kid=\"1-6-3-4-1\" data-name=\"lock icon\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-4-2\" data-name=\"field copy\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-4-2-1\" data-name=\"label\">\n                        Password\n                    </div>\n                    <div class=\"auth-field-value\" data-kid=\"1-6-3-4-2-2\" data-name=\"value\">\n                        ••••••••••\n                    </div>\n                </div>\n                <i class=\"ti ti-eye\" data-kid=\"1-6-3-4-3\" data-name=\"eye icon\" style=\"color:var(--muted)\">\n                </i>\n            </div>\n            <div class=\"auth-submit\" data-kid=\"1-6-3-5\" data-name=\"submit button\">\n                Sign in\n            </div>\n            <div class=\"auth-foot\" data-kid=\"1-6-3-6\" data-name=\"auth footer\">\n                <span data-kid=\"1-6-3-6-1\" data-name=\"footer text\">\n                    New here?\n                </span>\n                <strong data-kid=\"1-6-3-6-2\" data-name=\"footer link\">\n                    Create account\n                </strong>\n            </div>\n            <div class=\"auth-state\" data-kid=\"1-6-3-7\" data-name=\"auth state area\">\n                <div class=\"auth-state-row\" data-kid=\"1-6-3-7-1\" data-name=\"signing in row\">\n                    <i class=\"ti ti-loader-2\" data-dynamic=\"true\" data-kid=\"1-6-3-7-1-1\" data-name=\"loading spinner icon\" data-reason=\"rotated by css animation when visible\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-6-3-7-1-2\" data-name=\"signing in status text\" data-reason=\"text reflects async auth state\">\n                        Signing in · quiet inline progress\n                    </span>\n                </div>\n                <div class=\"auth-state-row error\" data-kid=\"1-6-3-7-2\" data-name=\"error row\">\n                    <i class=\"ti ti-alert-circle\" data-kid=\"1-6-3-7-2-1\" data-name=\"error icon\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-6-3-7-2-2\" data-name=\"error status message\" data-reason=\"text reflects async auth state\">\n                        Couldn’t sign in · Try again\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"1-6-3-8\" data-name=\"spacer block\" style=\"height:52px\">\n            </div>\n            <div class=\"auth-head\" data-kid=\"1-6-3-9\" data-name=\"setup profile header\" style=\"padding-bottom:18px\">\n                <h1 data-kid=\"1-6-3-9-1\" data-name=\"headline\" style=\"font-size:25px;line-height:31px\">\n                    Set up your profile\n                </h1>\n                <p data-kid=\"1-6-3-9-2\" data-name=\"subheadline\">\n                    This is how people will find you.\n                </p>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-10\" data-name=\"name field\">\n                <i class=\"ti ti-badge\" data-kid=\"1-6-3-10-1\" data-name=\"badge icon\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-10-2\" data-name=\"field copy\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-10-2-1\" data-name=\"label\">\n                        Your name\n                    </div>\n                    <div class=\"auth-field-value muted\" data-kid=\"1-6-3-10-2-2\" data-name=\"value\">\n                        Alex Morgan\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-11\" data-name=\"username field\">\n                <i class=\"ti ti-at\" data-kid=\"1-6-3-11-1\" data-name=\"at icon\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-11-2\" data-name=\"field copy\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-11-2-1\" data-name=\"label\">\n                        Username\n                    </div>\n                    <div class=\"auth-field-value muted\" data-kid=\"1-6-3-11-2-2\" data-name=\"value\">\n                        alexm\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-submit\" data-kid=\"1-6-3-12\" data-name=\"create profile submit button\">\n                Create profile\n            </div>\n        </div>\n    </section>\n    <section class=\"snapshot snapshot-states\" data-kid=\"1-7\">\n        <div class=\"board-caption\" data-kid=\"1-7-1\" data-name=\"states page caption\">\n            <span data-kid=\"1-7-1-1\">\n                07\n            </span>\n            / states · compact system strip\n        </div>\n        <div class=\"states-intro\" data-kid=\"1-7-2\" data-name=\"states intro text\">\n            <h2 data-kid=\"1-7-2-1\" data-name=\"headline\">\n                Quiet, truthful states\n            </h2>\n            <p data-kid=\"1-7-2-2\" data-name=\"subheadline\">\n                Every state uses the same hierarchy: one small cue, one clear sentence, one next step.\n            </p>\n        </div>\n        <div class=\"state-grid\" data-kid=\"1-7-3\" data-name=\"state grid\">\n            <div class=\"state-cell\" data-kid=\"1-7-3-1\" data-name=\"no conversation cell\">\n                <i class=\"ti ti-message-off\" data-kid=\"1-7-3-1-1\" data-name=\"icon\">\n                </i>\n                <h3 data-kid=\"1-7-3-1-2\" data-name=\"title\">\n                    No conversations yet\n                </h3>\n                <p data-kid=\"1-7-3-1-3\" data-name=\"description\">\n                    Search by username to start one.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-1-4\" data-name=\"action button\">\n                    Search\n                </span>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-2\" data-name=\"no messages cell\">\n                <i class=\"ti ti-message-circle\" data-kid=\"1-7-3-2-1\" data-name=\"icon\">\n                </i>\n                <h3 data-kid=\"1-7-3-2-2\" data-name=\"title\">\n                    No messages yet\n                </h3>\n                <p data-kid=\"1-7-3-2-3\" data-name=\"description\">\n                    Write the first message.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-2-4\" data-name=\"action button\">\n                    Write message\n                </span>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-3\" data-name=\"loading cell\">\n                <i class=\"ti ti-loader-2\" data-kid=\"1-7-3-3-1\" data-name=\"icon\">\n                </i>\n                <div class=\"skeleton-line\" data-kid=\"1-7-3-3-2\" data-name=\"skeleton 1\">\n                </div>\n                <div class=\"skeleton-line short\" data-kid=\"1-7-3-3-3\" data-name=\"skeleton 2\">\n                </div>\n                <p data-kid=\"1-7-3-3-4\" data-name=\"description\">\n                    Loading messages\n                </p>\n            </div>\n            <div class=\"state-cell error\" data-kid=\"1-7-3-4\" data-name=\"error cell\">\n                <i class=\"ti ti-alert-circle\" data-kid=\"1-7-3-4-1\" data-name=\"icon\">\n                </i>\n                <h3 data-kid=\"1-7-3-4-2\" data-name=\"title\">\n                    Couldn’t load messages\n                </h3>\n                <p data-kid=\"1-7-3-4-3\" data-name=\"description\">\n                    Your saved messages are still here.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-4-4\" data-name=\"action button\">\n                    Try again\n                </span>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-5\" data-name=\"no media cell\">\n                <i class=\"ti ti-photo-off\" data-kid=\"1-7-3-5-1\" data-name=\"icon\">\n                </i>\n                <h3 data-kid=\"1-7-3-5-2\" data-name=\"title\">\n                    No shared media\n                </h3>\n                <p data-kid=\"1-7-3-5-3\" data-name=\"description\">\n                    Photos will appear here.\n                </p>\n            </div>\n            <div class=\"state-cell\" data-kid=\"1-7-3-6\" data-name=\"no matches cell\">\n                <i class=\"ti ti-users-minus\" data-kid=\"1-7-3-6-1\" data-name=\"icon\">\n                </i>\n                <h3 data-kid=\"1-7-3-6-2\" data-name=\"title\">\n                    No members match\n                </h3>\n                <p data-kid=\"1-7-3-6-3\" data-name=\"description\">\n                    Try a different name.\n                </p>\n                <span class=\"state-action\" data-kid=\"1-7-3-6-4\" data-name=\"action button\">\n                    Clear search\n                </span>\n            </div>\n        </div>\n        <div class=\"note\" data-kid=\"1-7-4\" data-name=\"footer note text\">\n            One palette. One rail. No false presence, delivery, or security claims. All primary flows remain recognizably YOKOSU and ready for Compose translation.\n        </div>\n    </section>\n</div>\n",
      "comments": [],
      "created": "2026-08-30T14:33:41.139978+00:00",
      "modified": "2026-08-30T14:37:12.776176+00:00",
      "id": "var_warm_mineral_colorway"
    },
    "var_c1a61c188313": {
      "type": "variant",
      "label": "YOKOSU — Muted Botanical Colorway",
      "parentId": "var_9a52280e818e",
      "themeId": null,
      "rect": {
        "x": 950,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.board {\n  --pearl: #F2F4F1;\n  --white: #FDFDFD;\n  --stone: #E6EAE3;\n  --graphite: #2C3530;\n  --muted: #7D8A82;\n  --border: #D8DFD6;\n  --lavender: #49796B;\n  --lavender-tint: #E0E8E5;\n  --sage: #3EB489;\n  --danger: #C74375;\n  --reply-wash: rgba(253,253,253,0.55);\n  --shadow-ink: rgba(44,53,48,0.08);\n  width: 100%;\n  min-height: 100vh;\n  overflow-x: hidden;\n  background: var(--pearl);\n  color: var(--graphite);\n  font-family: 'Manrope', sans-serif;\n  letter-spacing: -0.01em;\n}\n.board, .board * { box-sizing: border-box; }\n.board i { line-height: 1; }\n.snapshot {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  border-bottom: 1px solid var(--border);\n  background: var(--pearl);\n}\n.snapshot-home { min-height: 800px; }\n.snapshot-chat { min-height: 1120px; }\n.snapshot-group { min-height: 1280px; }\n.snapshot-utilities { min-height: 1500px; }\n.snapshot-profile { min-height: 870px; }\n.snapshot-auth { min-height: 930px; }\n.snapshot-states { min-height: 520px; border-bottom: 0; }\n.board-caption {\n  padding: 22px 20px 10px;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 14px;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n.board-caption span { color: var(--lavender); }\n.status {\n  display: flex;\n  height: 26px;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 20px;\n  color: var(--graphite);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n}\n.status-icons { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; }\n.top-safe { padding-top: 7px; }\n.home-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  padding: 26px 20px 18px 24px;\n}\n.home-head h1, .auth-head h1 { margin: 0; font-size: 36px; line-height: 42px; font-weight: 400; letter-spacing: -0.065em; }\n.home-sub { margin-top: 5px; color: var(--muted); font-size: 12px; line-height: 16px; font-weight: 500; }\n.home-actions { display: flex; align-items: center; gap: 5px; padding-top: 3px; }\n.icon-target {\n  display: grid;\n  width: 48px;\n  height: 48px;\n  place-items: center;\n  color: var(--graphite);\n  font-size: 20px;\n}\n.icon-target.quiet { color: var(--muted); }\n.icon-target.lav { color: var(--lavender); }\n.avatar {\n  position: relative;\n  display: grid;\n  flex: none;\n  width: 42px;\n  height: 42px;\n  place-items: center;\n  overflow: visible;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: var(--stone);\n  color: var(--graphite);\n  font-size: 14px;\n  font-weight: 700;\n}\n.avatar.small { width: 34px; height: 34px; font-size: 11px; }\n.avatar.large { width: 82px; height: 82px; font-size: 25px; }\n.avatar.maya { background: var(--lavender-tint); }\n.avatar.olive { background: var(--stone); }\n.presence {\n  position: absolute;\n  right: -1px;\n  bottom: 0;\n  width: 10px;\n  height: 10px;\n  border: 2px solid var(--pearl);\n  border-radius: 50%;\n  background: var(--sage);\n}\n.search-field {\n  display: flex;\n  height: 48px;\n  align-items: center;\n  gap: 10px;\n  margin: 0 16px 16px;\n  padding: 0 14px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--white);\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 500;\n}\n.search-field i { font-size: 18px; }\n.conversation-list { padding: 2px 8px 96px; }\n.conversation-row {\n  position: relative;\n  display: flex;\n  min-height: 76px;\n  align-items: center;\n  gap: 14px;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n}\n.conversation-row:last-child { border-bottom: 0; }\n.conversation-row.selected {\n  border-bottom-color: transparent;\n  border-radius: 10px;\n  background: var(--lavender-tint);\n}\n.conversation-row.selected:before {\n  position: absolute;\n  left: 3px;\n  bottom: 18px;\n  width: 3px;\n  height: 14px;\n  border-radius: 3px;\n  background: var(--lavender);\n  content: '';\n}\n.row-copy { min-width: 0; flex: 1; }\n.row-top, .row-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.row-top { margin-bottom: 5px; }\n.row-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; line-height: 20px; font-weight: 700; }\n.row-time { flex: none; color: var(--muted); font-size: 11px; line-height: 16px; font-weight: 600; }\n.row-preview { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 12px; line-height: 17px; font-weight: 500; }\n.row-preview strong { color: var(--graphite); font-weight: 600; }\n.unread { display: grid; width: 22px; height: 22px; flex: none; place-items: center; border-radius: 50%; background: var(--stone); color: var(--graphite); font-size: 10px; font-weight: 700; }\n.group-mosaic { position: relative; display: grid; width: 42px; height: 42px; flex: none; grid-template-columns: 1fr 1fr; gap: 2px; overflow: hidden; border: 1px solid var(--border); border-radius: 50%; background: var(--stone); padding: 7px; }\n.group-mosaic span { display: grid; place-items: center; border-radius: 50%; background: var(--white); color: var(--graphite); font-size: 7px; font-weight: 700; }\n.group-mosaic span:nth-child(2), .group-mosaic span:nth-child(3) { background: var(--lavender-tint); }\n.group-mosaic.large { width: 92px; height: 92px; padding: 15px; gap: 3px; }\n.group-mosaic.large span { font-size: 11px; }\n.bottom-nav {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  display: flex;\n  height: 76px;\n  align-items: center;\n  justify-content: space-around;\n  border-top: 1px solid var(--border);\n  background: var(--white);\n  padding: 7px 22px 11px;\n}\n.nav-item { display: flex; width: 76px; height: 58px; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: var(--muted); font-size: 10px; font-weight: 600; }\n.nav-item i { display: grid; width: 28px; height: 24px; place-items: center; border-radius: 8px; font-size: 19px; }\n.nav-item.active { color: var(--graphite); }\n.nav-item.active i { background: var(--lavender-tint); color: var(--lavender); }\n\n.chat-shell { position: relative; min-height: 1120px; }\n.chat-header {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  height: 72px;\n  align-items: center;\n  gap: 3px;\n  padding: 0 10px 0 4px;\n  border-bottom: 1px solid var(--border);\n  background: var(--pearl);\n}\n.drag-control { position: relative; display: grid; width: 48px; height: 48px; place-items: center; }\n.drag-disc { position: relative; display: grid; width: 32px; height: 32px; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: var(--stone); color: var(--graphite); font-size: 18px; transform: translateX(7px); }\n.drag-disc:after { position: absolute; right: -7px; top: 8px; width: 3px; height: 15px; border-radius: 3px; background: var(--lavender); content: ''; opacity: 0.75; }\n.identity { display: flex; min-width: 0; flex: 1; align-items: center; gap: 9px; }\n.identity-copy { min-width: 0; }\n.identity-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 16px; line-height: 21px; font-weight: 700; }\n.identity-status { display: flex; align-items: center; gap: 5px; margin-top: 2px; color: var(--sage); font-size: 11px; line-height: 15px; font-weight: 600; }\n.status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sage); }\n.header-actions { display: flex; align-items: center; }\n.header-actions .icon-target { width: 44px; height: 48px; font-size: 18px; }\n.thread-seam { position: absolute; top: 72px; bottom: 104px; left: 20px; width: 1px; background: var(--border); opacity: 0.8; }\n.thread-seam:after { position: absolute