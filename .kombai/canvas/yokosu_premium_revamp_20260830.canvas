-kid=\"1-5-3-2-2\">\n                    <h2 data-kid=\"1-5-3-2-2-1\">\n                        Ari Morgan\n                    </h2>\n                    <p data-kid=\"1-5-3-2-2-2\">\n                        @arimorgan · ari@example.com\n                    </p>\n                    <div class=\"edit-link\" data-kid=\"1-5-3-2-2-3\">\n                        <i class=\"ti ti-pencil\" data-kid=\"1-5-3-2-2-3-1\">\n                        </i>\n                        Edit profile\n                    </div>\n                </div>\n            </div>\n            <div class=\"settings-section\" data-kid=\"1-5-3-3\">\n                <div class=\"section-title\" data-kid=\"1-5-3-3-1\">\n                    Account settings\n                </div>\n                <div class=\"setting-row\" data-kid=\"1-5-3-3-2\">\n                    <i class=\"ti ti-user\" data-kid=\"1-5-3-3-2-1\">\n                    </i>\n                    <span data-kid=\"1-5-3-3-2-2\">\n                        Personal information\n                    </span>\n                    <i class=\"ti ti-chevron-right\" data-kid=\"1-5-3-3-2-3\">\n                    </i>\n                </div>\n                <div class=\"setting-row\" data-kid=\"1-5-3-3-3\">\n                    <i class=\"ti ti-bell\" data-kid=\"1-5-3-3-3-1\">\n                    </i>\n                    <span data-kid=\"1-5-3-3-3-2\">\n                        Notifications\n                    </span>\n                    <i class=\"ti ti-chevron-right\" data-kid=\"1-5-3-3-3-3\">\n                    </i>\n                </div>\n                <div class=\"setting-row\" data-kid=\"1-5-3-3-4\">\n                    <i class=\"ti ti-lock\" data-kid=\"1-5-3-3-4-1\">\n                    </i>\n                    <span data-kid=\"1-5-3-3-4-2\">\n                        Privacy\n                    </span>\n                    <i class=\"ti ti-chevron-right\" data-kid=\"1-5-3-3-4-3\">\n                    </i>\n                </div>\n                <div class=\"setting-row\" data-kid=\"1-5-3-3-5\">\n                    <i class=\"ti ti-palette\" data-kid=\"1-5-3-3-5-1\">\n                    </i>\n                    <span data-kid=\"1-5-3-3-5-2\">\n                        Appearance\n                    </span>\n                    <i class=\"ti ti-chevron-right\" data-kid=\"1-5-3-3-5-3\">\n                    </i>\n                </div>\n                <div class=\"setting-row\" data-kid=\"1-5-3-3-6\">\n                    <i class=\"ti ti-database\" data-kid=\"1-5-3-3-6-1\">\n                    </i>\n                    <span data-kid=\"1-5-3-3-6-2\">\n                        Data & storage\n                    </span>\n                    <i class=\"ti ti-chevron-right\" data-kid=\"1-5-3-3-6-3\">\n                    </i>\n                </div>\n            </div>\n            <div class=\"danger-link\" data-kid=\"1-5-3-4\">\n                <i class=\"ti ti-logout\" data-kid=\"1-5-3-4-1\">\n                </i>\n                Sign out\n            </div>\n        </div>\n    </section>\n    <section class=\"screen\" data-kid=\"1-6\">\n        <div class=\"screen-label\" data-kid=\"1-6-1\">\n            <span data-kid=\"1-6-1-1\">\n                05 · authentication\n            </span>\n            <span data-kid=\"1-6-1-2\">\n                light + quiet\n            </span>\n        </div>\n        <div class=\"auth-block\" data-kid=\"1-6-2\">\n            <div class=\"auth-wordmark\" data-kid=\"1-6-2-1\">\n                <strong data-kid=\"1-6-2-1-1\">\n                    YOKOSU\n                </strong>\n                <span class=\"wordmark-rule\" data-kid=\"1-6-2-1-2\">\n                </span>\n            </div>\n            <h2 data-kid=\"1-6-2-2\">\n                Sign in\n            </h2>\n            <p class=\"auth-subtitle\" data-kid=\"1-6-2-3\">\n                Your conversations, kept close.\n            </p>\n            <div class=\"auth-field focused\" data-kid=\"1-6-2-4\">\n                <label data-kid=\"1-6-2-4-1\">\n                    Email address\n                </label>\n                <span data-kid=\"1-6-2-4-2\">\n                    ari@example.com\n                </span>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-2-5\">\n                <label data-kid=\"1-6-2-5-1\">\n                    Password\n                </label>\n                <span data-kid=\"1-6-2-5-2\">\n                    ••••••••••\n                </span>\n                <i class=\"ti ti-eye\" data-kid=\"1-6-2-5-3\">\n                </i>\n            </div>\n            <div class=\"auth-button\" data-kid=\"1-6-2-6\">\n                Sign in\n            </div>\n            <div class=\"auth-switch\" data-kid=\"1-6-2-7\">\n                New here?\n                <strong data-kid=\"1-6-2-7-1\">\n                    Create account\n                </strong>\n            </div>\n        </div>\n        <div class=\"profile-setup\" data-kid=\"1-6-3\">\n            <h3 data-kid=\"1-6-3-1\">\n                Set up your profile\n            </h3>\n            <p data-kid=\"1-6-3-2\">\n                This is how people will find you.\n            </p>\n            <div class=\"auth-field focused\" data-kid=\"1-6-3-3\">\n                <label data-kid=\"1-6-3-3-1\">\n                    Your name\n                </label>\n                <span data-kid=\"1-6-3-3-2\">\n                    Ari Morgan\n                </span>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-4\">\n                <label data-kid=\"1-6-3-4-1\">\n                    Username\n                </label>\n                <span data-kid=\"1-6-3-4-2\">\n                    @arimorgan\n                </span>\n            </div>\n            <div class=\"auth-button\" data-kid=\"1-6-3-5\">\n                Save profile\n            </div>\n        </div>\n    </section>\n    <section class=\"screen\" data-kid=\"1-7\">\n        <div class=\"screen-label\" data-kid=\"1-7-1\">\n            <span data-kid=\"1-7-1-1\">\n                06 · quiet states\n            </span>\n            <span data-kid=\"1-7-1-2\">\n                real feedback\n            </span>\n        </div>\n        <div class=\"state-block\" data-kid=\"1-7-2\">\n            <h3 data-kid=\"1-7-2-1\">\n                Small states, clear next steps\n            </h3>\n            <div class=\"state-grid\" data-kid=\"1-7-2-2\">\n                <div class=\"state-tile\" data-kid=\"1-7-2-2-1\">\n                    <i class=\"ti ti-message-circle\" data-kid=\"1-7-2-2-1-1\">\n                    </i>\n                    <strong data-kid=\"1-7-2-2-1-2\">\n                        No conversations yet\n                    </strong>\n                    <span data-kid=\"1-7-2-2-1-3\">\n                        Search by username to start one.\n                    </span>\n                </div>\n                <div class=\"state-tile\" data-kid=\"1-7-2-2-2\">\n                    <i class=\"ti ti-users\" data-kid=\"1-7-2-2-2-1\">\n                    </i>\n                    <strong data-kid=\"1-7-2-2-2-2\">\n                        No members match\n                    </strong>\n                    <span data-kid=\"1-7-2-2-2-3\">\n                        Try another name or username.\n                    </span>\n                </div>\n                <div class=\"state-tile\" data-dynamic=\"true\" data-kid=\"1-7-2-2-3\" data-name=\"loading messages state tile\" data-reason=\"tile displayed while data is fetching\">\n                    <i class=\"ti ti-loader-2\" data-kid=\"1-7-2-2-3-1\">\n                    </i>\n                    <strong data-kid=\"1-7-2-2-3-2\">\n                        Loading messages\n                    </strong>\n                    <div class=\"skeleton-lines\" data-kid=\"1-7-2-2-3-3\">\n                        <span data-kid=\"1-7-2-2-3-3-1\">\n                        </span>\n                        <span data-kid=\"1-7-2-2-3-3-2\">\n                        </span>\n                        <span data-kid=\"1-7-2-2-3-3-3\">\n                        </span>\n                    </div>\n                </div>\n                <div class=\"state-tile error\" data-kid=\"1-7-2-2-4\">\n                    <i class=\"ti ti-alert-circle\" data-kid=\"1-7-2-2-4-1\">\n                    </i>\n                    <strong data-kid=\"1-7-2-2-4-2\">\n                        Couldn’t load messages\n                    </strong>\n                    <span data-kid=\"1-7-2-2-4-3\">\n                        Keep the thread and try again.\n                    </span>\n                    <div class=\"try-again\" data-kid=\"1-7-2-2-4-4\">\n                        Try again\n                        <i class=\"ti ti-arrow-right\" data-kid=\"1-7-2-2-4-4-1\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"state-tile\" data-kid=\"1-7-2-2-5\">\n                    <i class=\"ti ti-search\" data-kid=\"1-7-2-2-5-1\">\n                    </i>\n                    <strong data-kid=\"1-7-2-2-5-2\">\n                        No results\n                    </strong>\n                    <span data-kid=\"1-7-2-2-5-3\">\n                        Check the exact username.\n                    </span>\n                </div>\n                <div class=\"state-tile\" data-kid=\"1-7-2-2-6\">\n                    <i class=\"ti ti-photo-off\" data-kid=\"1-7-2-2-6-1\">\n                    </i>\n                    <strong data-kid=\"1-7-2-2-6-2\">\n                        No shared media\n                    </strong>\n                    <span data-kid=\"1-7-2-2-6-3\">\n                        Images will appear here.\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"footer-note\" data-kid=\"1-7-3\">\n            <span class=\"rail\" data-kid=\"1-7-3-1\">\n            </span>\n            <span data-kid=\"1-7-3-2\">\n                Pearl is structural. Stone is recessed. White floats only when it has a job. Lavender marks the one next action.\n            </span>\n        </div>\n    </section>\n</div>\n",
