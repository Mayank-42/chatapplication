            <span data-kid=\"1-6-3-7-1-2\" data-name=\"loading text\">\n                        Signing in · quiet inline progress\n                    </span>\n                </div>\n                <div class=\"auth-state-row error\" data-kid=\"1-6-3-7-2\" data-name=\"auth error state row\">\n                    <i class=\"ti ti-alert-circle\" data-kid=\"1-6-3-7-2-1\" data-name=\"alert icon\">\n                    </i>\n                    <span data-kid=\"1-6-3-7-2-2\" data-name=\"error text\">\n                        Couldn’t sign in · Try again\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"1-6-3-8\" data-name=\"spacing container\" style=\"height:52px\">\n            </div>\n            <div class=\"auth-head\" data-kid=\"1-6-3-9\" data-name=\"auth header\" style=\"padding-bottom:18px\">\n                <h1 data-kid=\"1-6-3-9-1\" data-name=\"header title\" style=\"font-size:25px;line-height:31px\">\n                    Set up your profile\n                </h1>\n                <p data-kid=\"1-6-3-9-2\" data-name=\"header text\">\n                    This is how people will find you.\n                </p>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-10\" data-name=\"name input field\">\n                <i class=\"ti ti-badge\" data-kid=\"1-6-3-10-1\" data-name=\"input icon\">\n                </i>\n                <div class=\"auth-field-copy\" data-kid=\"1-6-3-10-2\" data-name=\"input info\">\n                    <div class=\"auth-field-label\" data-kid=\"1-6-3-10-2-1\" data-name=\"input label\">\n                        Your name\n                    </div>\n                    <div class=\"auth-field-value muted\" data-kid=\"1-6-3-10-2-2\" data-name=\"input value\">\n                        Alex Morgan\n                    </div>\n                </div>\n            </div>\n            <div class=\"auth-field\" data-kid=\"1-6-3-11\" data-name=\"username input field\">\n 